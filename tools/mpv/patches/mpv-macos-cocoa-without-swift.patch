mpv 0.42.0: make -Dcocoa=enabled -Dswift-build=disabled build and run.

Our macOS libmpv needs cocoa (gl-cocoa, VideoToolbox GL interop for the render API) but not Swift: mpv's Swift
AppHub replaces the host's NSApp.mainMenu and does DispatchQueue.main.sync inside mpv_initialize, both wrong for
an embedder. mpv 0.42 does not support that combination:
- player/clipboard/clipboard-mac.m includes the Swift-generated osdep/mac/swift.h unconditionally (compile error).
  It is now built and registered only with Swift.
- osdep/mac/app_bridge.m defines the cocoa_* entry points only with Swift, yet player/main.c and input/input.c
  call them under HAVE_COCOA. mpv links with b_lundef=false, so the dylib links and then crashes in
  mpv_create/mpv_initialize. Without Swift they are now no-ops.
Applied by tools/mpv/macos.sh; drop it when the pinned mpv handles this upstream.

--- a/meson.build
+++ b/meson.build
@@ -437,8 +437,7 @@
     path_source += files('osdep/path-mac.m')
     sources += files('osdep/language-mac.c',
                      'osdep/utils-mac.c',
-                     'osdep/mac/app_bridge.m',
-                     'player/clipboard/clipboard-mac.m')
+                     'osdep/mac/app_bridge.m')
     main_fn_source = files('osdep/main-fn-mac.c')
 endif
 
@@ -1634,6 +1633,7 @@
 
 swift_sources = []
 if features['cocoa'] and features['swift']
+    sources += files('player/clipboard/clipboard-mac.m')
     swift_sources += files('osdep/mac/application.swift',
                            'osdep/mac/app_hub.swift',
                            'osdep/mac/clipboard.swift',
--- a/osdep/mac/app_bridge.m
+++ b/osdep/mac/app_bridge.m
@@ -165,4 +165,13 @@
 {
     return [(Application *)[Application sharedApplication] main:argc :argv];
 }
+#else
+// Without Swift there is no AppHub: player/main.c and input/input.c still call these under HAVE_COCOA, and
+// b_lundef=false would otherwise leave them as unresolved symbols that crash at mpv_create/mpv_initialize.
+void cocoa_init_media_keys(void) {}
+void cocoa_uninit_media_keys(void) {}
+void cocoa_set_input_context(struct input_ctx *input_context) {}
+void cocoa_set_mpv_handle(struct mpv_handle *ctx) {}
+void cocoa_init_cocoa_cb(void) {}
+int cocoa_main(int argc, char *argv[]) { return 1; }
 #endif
--- a/player/clipboard/clipboard.c
+++ b/player/clipboard/clipboard.c
@@ -40,7 +40,7 @@
 #if HAVE_WIN32_DESKTOP
     &clipboard_backend_win32,
 #endif
-#if HAVE_COCOA
+#if HAVE_COCOA && HAVE_SWIFT
     &clipboard_backend_mac,
 #endif
 #if HAVE_WAYLAND && HAVE_WAYLAND_PROTOCOLS_1_39
