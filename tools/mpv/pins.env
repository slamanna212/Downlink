# Pinned engine inputs, sourced by build-linux.sh / linux.sh / linux-docker.sh and read by windows.ps1.
# Every platform ships the same mpv release. Change together with PINNED.md.
MPV_VERSION=0.42.0

# Windows: mpv's official libmpv build (GitHub release asset), verified by SHA-256.
MPV_WIN_ASSET=libmpv-v0.42.0-x86_64-w64-mingw32-gpl.zip
MPV_WIN_SHA256=b99e0d183024ae479d1b36a93fa262c0297dfb025b99715b98da377ffb6c2913

# Linux: built from source inside this container (glibc 2.41 / Wayland 1.23 floor), against Debian's
# FFmpeg 7.1. Dev machines, CI and release all run linux-docker.sh, so they use identical bits.
MPV_LINUX_IMAGE=debian:13@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6
MPV_SRC_SHA256=bcfebbfa2b65a6d88dc97ea18117831072373e38b5785a2afb874ed4df5070dd
LIBPLACEBO_VERSION=7.387.0
LIBPLACEBO_COMMIT=275f7dea27924cdd34ab2e6c20e448b6bc4fab65

# macOS (Apple Silicon only): built from source by macos.sh on an arm64 runner. FFmpeg, libass (+ FreeType,
# FriBidi, HarfBuzz) and libplacebo are linked statically into one libmpv.2.dylib that needs only the OS.
MPV_MACOS_MIN=13.0
FFMPEG_VERSION=7.1.5
FFMPEG_SHA256=de668509caf9e35e3cd162473441fdb29538c6d96ed080292b3cf9e6fc5d558f
LIBASS_VERSION=0.17.5
LIBASS_SHA256=2dca25c0e0c837ddf00b52011b3f82cac1e4ddd3ad018227806b0c2288864acc
FREETYPE_VERSION=2.14.3
FREETYPE_SHA256=36bc4f1cc413335368ee656c42afca65c5a3987e8768cc28cf11ba775e785a5f
FRIBIDI_VERSION=1.0.18
FRIBIDI_SHA256=1de5e8073d035388b71d0b2d452b1da1f8caeea8a7702997b401fe1b6250727f
HARFBUZZ_VERSION=15.2.0
HARFBUZZ_SHA256=e2ec49090744383cdbe7df808c1cedaafba06a97be8dc4211fe546ba585f12cb
