{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Downlink",
  "version": "0.7.0",
  "identifier": "com.slamanna212.downlink",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": {
      "script": "pnpm install --frozen-lockfile && pnpm dev",
      "cwd": "../ui"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../ui"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Downlink",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": true,
        "transparent": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' dlimg: http://dlimg.localhost https://dlimg.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' dlimg: http://dlimg.localhost https://dlimg.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; script-src 'self' 'unsafe-inline' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb",
      "rpm"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDMDYxMjJFRkNFMTFBMDcKUldRSEd1SDhMaElHckduTDE0djNTRlJNOVhkRUJLalhZdVg5THZ1RUY4bFF4NkV4YlpQWU1iazAK",
      "endpoints": [
        "https://github.com/slamanna212/Downlink/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "downlink"
        ]
      }
    }
  }
}
