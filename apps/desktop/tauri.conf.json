{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Downlink",
  "version": "0.1.0",
  "identifier": "com.slamanna212.downlink",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Downlink",
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": true,
        "transparent": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
